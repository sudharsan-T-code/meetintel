# ============================================================
# MEETINTEL - Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meetintel?schema=public"

# ------------------------------------------------------------
# NextAuth / Authentication
# ------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="meetintel_super_secure_enterprise_secret_key_change_in_production_2026"

# ------------------------------------------------------------
# AI Provider Configuration
# Supported providers: "demo" | "openai" | "anthropic" | "gemini" | "local"
# ------------------------------------------------------------
DEFAULT_AI_PROVIDER="demo"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Anthropic Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-7-sonnet-20250219"

# Google Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Local AI / Ollama Configuration
LOCAL_AI_ENDPOINT="http://localhost:11434/v1"
LOCAL_AI_MODEL="llama3"

# ------------------------------------------------------------
# Speech Provider Configuration
# Supported providers: "demo" | "whisper" | "google_cloud" | "azure"
# ------------------------------------------------------------
DEFAULT_SPEECH_PROVIDER="demo"

# Whisper Configuration (OpenAI or faster-whisper local endpoint)
WHISPER_API_KEY=""
WHISPER_ENDPOINT="https://api.openai.com/v1/audio/transcriptions"

# Google Cloud Speech-to-Text
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_CLIENT_EMAIL=""
GOOGLE_CLOUD_PRIVATE_KEY=""

# Azure Cognitive Speech Services
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# ------------------------------------------------------------
# Storage / Cloud Ingestion (S3 / R2 / GCS)
# ------------------------------------------------------------
STORAGE_PROVIDER="local"
S3_BUCKET_NAME=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------
# Public Client Variables
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="MEETINTEL"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"
